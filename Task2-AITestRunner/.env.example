# Optional AI Provider API Keys
# The tool automatically runs out-of-the-box in Autonomous NLP mode even without an API key!
# If you want to use an LLM provider, uncomment and set your key below:

# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Default starting URL (optional override)
# DEFAULT_URL=https://phptravels.net/login

# Browser settings
HEADLESS=false
BROWSER_TIMEOUT=15
SLOW_MOTION_MS=500

